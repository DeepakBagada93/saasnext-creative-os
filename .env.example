# Google Gemini API Key
# Get one from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Service Account JSON (Minified string or Base64 encoded)
# Required only for Firestore winners storage (otherwise falls back to in-memory)
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_here

# Server settings
# TRANSPORT=sse to run as web server, otherwise runs as stdio for local tools
TRANSPORT=stdio
PORT=3000
